# AmbyoAI API — FastAPI + uvicorn (Python 3.11)
# Build from repo root: docker build -f Dockerfile.backend .
#
# Models (.keras) are gitignored; mount a volume at runtime for full AI, or expect 503 until models exist.

FROM python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Minimal build deps for some wheels; TensorFlow wheel is manylinux-bundled
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend/ /app/

EXPOSE 8001

# Production validation (PII, JWT, CORS) runs at startup when ENV=production
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001"]
