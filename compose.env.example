# Copy to `.env` next to docker-compose.yml (Compose loads it for ${VAR} substitution only).
# Do not commit `.env`.

# --- Local laptop (defaults match docker-compose.yml if you skip this file) ---
# FRONTEND_HTTP_HOST=127.0.0.1
# FRONTEND_HTTP_PORT=8080
# FRONTEND_HTTPS_HOST=127.0.0.1
# FRONTEND_HTTPS_PORT=8443

# --- Public VPS + docker-compose.production.yml (uncomment for ambyoai.com) ---
# FRONTEND_HTTP_HOST=0.0.0.0
# FRONTEND_HTTP_PORT=80
# FRONTEND_HTTPS_HOST=0.0.0.0
# FRONTEND_HTTPS_PORT=443

# Frontend build: leave unset so the SPA uses same-origin /api (recommended).
# REACT_APP_BACKEND_URL=

# Backend (passed into docker-compose backend service): path inside container when ./backend/models → /app/models
# AMBYO_STRABISMUS_MODEL=/app/models/strabismus_model.keras
