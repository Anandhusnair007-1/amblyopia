# Copy to backend/.env for deployment (never commit backend/.env).
# Production startup fails closed unless secrets and CORS are safe — see server startup validation.

ENV=production

# MongoDB connection string.
# Docker Compose (internal network): mongodb://mongo:27017
# Atlas / hospital-hosted: mongodb+srv://user:pass@cluster/db?options
MONGO_URL=

# Optional: file logging directory inside the backend container (Compose sets LOG_DIR=/app/logs → ./logs/backend).
# LOG_DIR=/app/logs

DB_NAME=ambyoai

# JWT signing secret — must NOT be the repository default in production.
JWT_SECRET=

# Fernet key (url-safe base64): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# Long random string for HMAC phone/name lookups (not the Fernet key).
PII_LOOKUP_SECRET=

# Comma-separated browser origins, NO spaces. Never "*" in production (startup fails).
# Include every UI origin you use (scheme + host + port), comma-separated, no spaces.
# Public site example: https://ambyoai.com,https://www.ambyoai.com
# Local Docker: http://localhost:8080,https://localhost:8443
CORS_ORIGINS=https://ambyoai.com,https://www.ambyoai.com

# Pilot safety — defaults are safe when ENV=production even if unset here:
ENABLE_DEMO_OTP=false
ENABLE_SEED_DOCTOR=false

OTP_RATE_LIMIT=30/minute
LOGIN_RATE_LIMIT=15/minute

DATASET_VERSION=unknown

# Optional error monitoring
SENTRY_DSN=

# Optional: TensorFlow model paths (defaults under backend/models/)
# AMBYO_QUALITY_MODEL=/app/models/eye_quality_v1.keras
# AMBYO_DEVIATION_MODEL=/app/models/deviation/model.keras
# Docker Compose (WORKDIR /app): use /app/models/strabismus_model.keras when mounting ./backend/models → /app/models
AMBYO_STRABISMUS_MODEL=backend/models/strabismus_model.keras
