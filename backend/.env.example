# AmbyoAI Environment Configuration
ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=ambyoai

# Production: Must be min 32 random chars
JWT_SECRET=change-me-never-use-in-production

# Application PII (Fernet + HMAC lookup). Required in production (ENV=production).
# Generate key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=
# Min 32 random bytes as hex or long random string — used only for HMAC-SHA256 indexes (phone_hash, name_search_hash)
PII_LOOKUP_SECRET=

# Legacy: pre–P1.1 Fernet key for reading old ciphertext during migration only (optional)
ENCRYPTION_KEY=tJuVc0rcSE7XfCjjs6Fp0ERMBNs2h_KRrEgAgFEtc14=

# Error Tracking (Optional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# CORS: List of allowed domains (comma separated)
CORS_ORIGINS=http://localhost:3000

# Auth rate limits (e.g. "30/minute", "15/minute", "5/second")
OTP_RATE_LIMIT=30/minute
LOGIN_RATE_LIMIT=15/minute

# Demo & Seeding (Development only)
ENABLE_DEMO_OTP=true
DEMO_OTP=1234
ENABLE_SEED_DOCTOR=true

# AI/ML 
DATASET_VERSION=v0.2-clinical-audit
AMBYO_QUALITY_MODEL=backend/models/eye_quality_v1.keras
AMBYO_DEVIATION_MODEL=backend/models/deviation_v0_2_debug/model.keras
